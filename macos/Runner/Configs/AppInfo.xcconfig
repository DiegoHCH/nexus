// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Nexus

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.katanalabs.nexus

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Katana Labs. All rights reserved.

// Firma real, no ad-hoc: el Keychain de protección de datos exige el
// entitlement keychain-access-groups, y ese solo se concede con un certificado
// de verdad. Se firma con el Developer ID —el mismo que hará falta para
// distribuir fuera de la App Store— en vez de con automatic signing, que
// necesitaría que Xcode tuviera sesión abierta para emitir perfiles.
DEVELOPMENT_TEAM = Y9H7TRB5L7
CODE_SIGN_IDENTITY = Developer ID Application

// `pod install` avisa —una vez por configuración, tres en total— de que «no pudo
// poner su configuración base porque el proyecto ya tiene una propia» y sugiere
// apuntar la base del target Runner a `Pods-Runner.<config>.xcconfig`. **No se
// hace, y el aviso es esperado**: esta es la disposición estándar de Flutter en
// macOS —el target Runner tiene como base este AppInfo.xcconfig— y lo de Pods ya
// llega igual, por otra rama. `macos/Flutter/Flutter-Debug.xcconfig` (y su
// gemelo Release) abren con
//   #include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
// que Xcode resuelve contra SRCROOT (= `macos/`), y esos dos los incluye
// `Runner/Configs/Debug.xcconfig` / `Release.xcconfig`, que son la base a nivel
// de **proyecto**. Como AppInfo.xcconfig no define ninguno de los ajustes de
// Pods, estos bajan al target sin que nadie los pise: se comprueba con
// `xcodebuild -showBuildSettings`, donde OTHER_LDFLAGS trae `-framework
// "Sparkle"` y compañía y PODS_ROOT apunta a `macos/Pods`.
//
// Hacer lo que sugiere el aviso sería el error caro: la base del target solo
// admite un archivo, así que poner el de Pods **borra este** —y con él el bundle
// id, el equipo y la identidad de firma de aquí arriba—, que es justo lo que
// rompe la firma con Developer ID y las releases de Sparkle.
