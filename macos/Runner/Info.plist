<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Nexus necesita tu micrófono para escucharte cuando le hables.</string>
	<!-- Es un permiso **distinto** del micrófono y el sistema lo exige aparte:
	     sin esta clave, la primera llamada a SFSpeechRecognizer no pide nada,
	     revienta la app. Y el texto dice lo que de verdad pasa, que es lo único
	     que a alguien le importa de este diálogo: que no sale de aquí. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Nexus reconoce lo que dices en tu propio Mac, sin mandar el audio a ningún servicio.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- Actualizaciones. La interfaz no es la de Sparkle: ver NexusUpdater.swift. -->

	<!-- `latest/download` y no la URL de una etiqueta: GitHub redirige eso a la
	     última release publicada, así que la dirección no caduca. Sin esto haría
	     falta publicar el feed en otro sitio —Pages, un dominio— y mantenerlo. -->
	<key>SUFeedURL</key>
	<string>https://github.com/DiegoHCH/nexus/releases/latest/download/appcast.xml</string>

	<!-- La clave **pública** de firma de actualizaciones, y su sitio es este: va
	     dentro de la app para poder comprobar que el paquete que llega lo firmó
	     quien dice. La privada vive en el llavero y en los secretos del repo, y
	     no aparece en ningún archivo de aquí.

	     Es una segunda cerradura sobre la de Apple: aunque alguien lograra
	     colgar un zip en las releases, sin esta firma Sparkle lo rechaza. -->
	<key>SUPublicEDKey</key>
	<string>dnjW9FhSAPhvtcrDUj7kkbeEkUt+wEdBHs0voD+UyLc=</string>

	<key>SUEnableAutomaticChecks</key>
	<true/>

	<!-- Dos horas, que es la cadencia que ya tenía el aviso por su cuenta antes
	     de que existiera el actualizador. Se conserva a propósito: era la medida
	     buena —ni insistente ni dormida— y ahora la lleva quien debe llevarla. -->
	<key>SUScheduledCheckInterval</key>
	<integer>7200</integer>

	<!-- Nada se descarga sin que lo digas: la modal pregunta primero. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
</dict>
</plist>
